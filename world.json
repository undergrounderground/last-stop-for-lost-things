      },
      "narration": {
        "src": "audio/narration-station.mp3",
        "lines": [
          {
            "text": "I was looking for my keys. That's the whole reason.",
            "start": 0.38,
            "end": 3.47
          },
          {
            "text": "It was a Tuesday, I think, and it was raining the way it does when it can't really be bothered.",
            "start": 3.92,
            "end": 9.17
          },
          {
            "text": "There was a white thing sitting outside the stairs. About the size of a loaf of bread. It looked at me like I was late.",
            "start": 9.7,
            "end": 16.76
          }
        ]
      },
